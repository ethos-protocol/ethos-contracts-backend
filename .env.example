# --- Network Configuration ---
# Stellar/Soroban network (testnet, mainnet, or standalone)
STELLAR_NETWORK=testnet
# RPC URL for interacting with the Stellar network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase for transaction signing (e.g., "Test SDF Network ; September 2015" for testnet)
STELLAR_NETWORK_PASSPHRASE=

# --- Database (#690) ---
# Optional full database connection URL. When set it takes precedence over
# DB_PATH. Optional; default: unset (DB_PATH is used instead).
DATABASE_URL=
# SQLite file for vaults, notification subscriptions and audit rows. Defaults to
# /var/lib/ethos-protocol/ethos-protocol.db (a mounted volume in Docker). For a
# local `cargo run`, point this at a writable path, e.g. ./data/ethos-protocol.db
DB_PATH=
# Set to "true" to allow DB_PATH=:memory:. Data is lost on every restart.
# The server refuses to start with :memory: otherwise.
ALLOW_EPHEMERAL_DB=false

# --- Read Replicas (#696) ---
# Comma-separated list of read-replica database URLs. Optional; default: unset
# (all reads go to the primary).
READ_REPLICA_URLS=
# How reads are routed across replicas: primary, round_robin, or random.
# Optional; default: round_robin.
REPLICA_ROUTING_STRATEGY=round_robin
# Maximum age (seconds) a replica may lag before reads fall back to the primary.
# Optional; default: 5.
REPLICA_MAX_STALENESS_SECS=5
=======

# --- Contract Configuration ---
# The contract ID after deployment (e.g., CC...)
CONTRACT_TTL_VAULT=
# Stellar key pair identity name configured in Stellar CLI (e.g. "deployer")
STELLAR_IDENTITY=deployer
# Minimum contract version this backend build is compatible with.
# Backend refuses to start if the deployed contract version is below this.
# Default: 1
MIN_CONTRACT_VERSION=1

# --- Frontend Configuration ---
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# --- Mobile Configuration ---
# Base URL for the Ethos-Protocol backend API
IOS_API_BASE_URL=https://api.ethos-protocol.app/v1
ANDROID_API_BASE_URL=https://api.ethos-protocol.app/v1
# Stellar/Soroban network for mobile apps
IOS_STELLAR_NETWORK=testnet
ANDROID_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
IOS_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# --- Backend Configuration (Reminder Service) ---
# API key for sending email reminders
REMINDER_EMAIL_API_KEY=
# API key for sending SMS reminders
REMINDER_SMS_API_KEY=
# Secret key used to encrypt reminder data (email/phone) before storage
REMINDER_ENCRYPTION_SECRET=

# --- Field-Level Encryption (#101) ---
# Active key version (increment when rotating keys)
FIELD_ENCRYPTION_KEY_VERSION=1
# Base64-encoded 32-byte AES-256 key for the active version.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY_1=
# Keys for other versions follow the pattern FIELD_ENCRYPTION_KEY_<VERSION>,
# e.g. a previous key kept for decryption during the rotation grace period:
# FIELD_ENCRYPTION_KEY_0=

# --- Push Notifications (Firebase Cloud Messaging) ---
# FCM server key (OAuth2 access token or legacy server key)
FCM_SERVER_KEY=
# Firebase project ID (e.g. ethos-protocol-prod)
FCM_PROJECT_ID=
# How often (seconds) the background scheduler checks for due notifications
NOTIFICATION_SCHEDULER_INTERVAL_SECS=60

# --- CORS Configuration ---
# Comma-separated list of allowed origins. If empty, no origins are allowed.
# Example: https://app.ethos-protocol.com,https://staging.ethos-protocol.com
ALLOWED_ORIGINS=

# --- Database Pool Configuration ---
# Read-connection pool for file-backed SQLite (#696). A single writer connection
# handles all writes. Readers are opened up front (MIN) and grow on demand (MAX).
# In-memory databases (the current default) use one read connection regardless of MAX.
# Minimum read connections opened at startup (default: 2)
DB_POOL_MIN=2
# Maximum read connections (default: 10)
DB_POOL_MAX=10
# Seconds to wait for a free connection, and the SQLite busy timeout (default: 30)
DB_POOL_TIMEOUT_SECS=30

# --- Redis / Node Identity ---
# Redis connection URL used for caching and cross-node coordination.
# Optional; default: unset (in-process cache only).
REDIS_URL=
# Unique identifier for this node in a multi-node deployment.
# Optional; default: generated at startup.
NODE_ID=
# Consensus strategy used when coordinating across nodes (e.g. single, quorum).
# Optional; default: single.
CONSENSUS_STRATEGY=single

# --- RPC Client Pool ---
# RPC endpoint used for Stellar/Soroban calls. Optional; defaults to
# STELLAR_RPC_URL when unset.
RPC_ENDPOINT=
# Maximum idle connections kept per host in the RPC pool. Optional; default: 16.
RPC_POOL_MAX_IDLE_PER_HOST=16
# Seconds an idle RPC connection is kept before being closed. Optional; default: 90.
RPC_POOL_IDLE_TIMEOUT_SECS=90
# Seconds to wait when establishing an RPC connection. Optional; default: 10.
RPC_POOL_CONNECTION_TIMEOUT_SECS=10
# Seconds to wait for an RPC request to complete. Optional; default: 30.
RPC_POOL_REQUEST_TIMEOUT_SECS=30

# --- Tracing ---
# Enable distributed tracing. Optional; default: false.
TRACE_ENABLED=false
# Fraction of requests to sample when tracing (0.0-1.0). Optional; default: 0.1.
TRACE_SAMPLE_RATE=0.1
# Enable adaptive sampling based on request rate. Optional; default: false.
TRACE_ADAPTIVE=false
# Requests-per-second threshold above which adaptive sampling reduces the rate.
# Optional; default: 100.
TRACE_ADAPTIVE_HIGH_RPS=100
# Always trace requests that result in errors. Optional; default: true.
TRACE_ALWAYS_ERRORS=true

# --- Logging ---
# Minimum log level (trace, debug, info, warn, error). Optional; default: info.
LOG_LEVEL=info
# Comma-separated allowlist of modules to log. Optional; default: all modules.
LOG_MODULES=
# Comma-separated denylist of modules to suppress. Optional; default: none.
LOG_EXCLUDE_MODULES=
# Number of log records buffered before flushing. Optional; default: 1024.
LOG_BUFFER_SIZE=1024
# Number of log records written per batch. Optional; default: 256.
LOG_BATCH_SIZE=256
# Emit logs as structured JSON. Optional; default: false.
STRUCTURED_LOGGING_ENABLED=false

# --- Admin API ---
# API key required to authenticate admin endpoints. Required in production.
ADMIN_API_KEY=
# Allow admin endpoints without an API key. Never enable in production.
# Optional; default: false.
ALLOW_INSECURE_ADMIN=false

# --- AML / Sanctions Screening ---
# API key for the AML screening provider. Optional; screening disabled if unset.
AML_API_KEY=
# Base URL of the AML screening provider. Optional; default: provider default.
AML_API_URL=
# Seconds to cache AML screening results. Optional; default: 3600.
AML_CACHE_TTL_SECS=3600
# If "true", allow requests through when the AML provider is unreachable.
# Optional; default: false (fail closed).
AML_FAIL_OPEN=false
# Base URL of the Chainalysis API. Optional; default: Chainalysis default.
CHAINALYSIS_API_URL=

# --- Proxy / Networking ---
# Comma-separated list of trusted proxy IPs whose X-Forwarded-* headers are
# honored. Optional; default: unset (no proxies trusted).
TRUSTED_PROXY_IPS=
