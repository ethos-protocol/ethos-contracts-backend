{
  "title": "Ethos-Protocol: Credential Lifecycle & Errors",
  "uid": "ethos-credential-lifecycle",
  "tags": ["ethos-protocol", "credentials", "errors"],
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Credential Lifecycle Transitions (rate)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ethos_protocol_credential_lifecycle_transitions_total[5m])" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Credential Lifecycle Errors (rate)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ethos_protocol_credential_lifecycle_errors_total[5m])" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ethos_protocol_request_errors_total[5m]) / clamp_min(rate(ethos_protocol_http_requests_total[5m]), 1)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "API p50/p95/p99 Latency",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(ethos_protocol_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(ethos_protocol_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(ethos_protocol_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
